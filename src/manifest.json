{
  "manifest_version": 3,
  "name": "Steer Clear",
  "version": "1.0.0",
  "description": "Catch the reflex. Sites you'd rather not open show you your own reason first — and a one-click way somewhere better.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "action": {
    "default_title": "Steer Clear settings"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked/blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
